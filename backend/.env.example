# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
# Loopback by default: the API can publish videos, so it is not a network service.
HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Access control
# Leave API_TOKEN empty to auto-generate one in backend/.api-token (gitignored).
# ---------------------------------------------------------------------------
API_TOKEN=
# Fallback approver name shown in the UI and stored in videos.approved_by.
APPROVER_NAME=

# ---------------------------------------------------------------------------
# Database (PostgreSQL / Supabase)
# Leave DATABASE_URL empty to use the ephemeral in-memory dev store.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://yt:yt@localhost:5432/yt_autopilot
DATABASE_SSL=false

# ---------------------------------------------------------------------------
# Queue (Redis + BullMQ). Leave empty to render inline in the API process.
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
RUN_WORKER=true

# ---------------------------------------------------------------------------
# AI (Google Gemini 2.5 Flash)
# https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Text to speech
# edge = edge-tts-universal (no key). google = Google Cloud TTS (GOOGLE_TTS_KEY).
# ---------------------------------------------------------------------------
TTS_PROVIDER=edge
TTS_VOICE=en-IN-NeerjaNeural
TTS_RATE=+0%
GOOGLE_TTS_KEY=
GOOGLE_TTS_VOICE=

# ---------------------------------------------------------------------------
# Stock visuals (https://www.pexels.com/api/)
# ---------------------------------------------------------------------------
PEXELS_API_KEY=

# ---------------------------------------------------------------------------
# YouTube Data API v3 (OAuth 2.0 desktop/web client)
# ---------------------------------------------------------------------------
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REDIRECT_URI=http://localhost:3000/api/youtube/callback
# Set to true ONLY after Google approves your app's compliance audit.
YT_AUDIT_PASSED=false
# Disclose altered/synthetic content on every upload (status.containsSyntheticMedia). Keep true.
YT_DISCLOSE_SYNTHETIC_MEDIA=true
YT_CATEGORY_ID=22
# BCP-47 language of the caption track uploaded from the rendered .srt sidecar.
YT_CAPTION_LANGUAGE=en
# YouTube allows ~6 uploads/day (videos.insert costs 1600 of 10,000 daily units).
MAX_UPLOADS_PER_DAY=6

# ---------------------------------------------------------------------------
# Admin alerts (Telegram)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Scheduler (node-cron)
# ---------------------------------------------------------------------------
SCHEDULER_ENABLED=false
CRON_SCHEDULE=0 18 * * *
CRON_TIMEZONE=Asia/Kolkata
# Boot catch-up: run once if no run started within this many hours (match the cron period).
PIPELINE_CATCH_UP_HOURS=24
# Startup recovery: a ledger row still "running" this long after it started had its process killed.
PIPELINE_STALE_RUN_MINUTES=120
DEFAULT_NICHE=personal finance
DEFAULT_AUDIENCE=young professionals in India
DEFAULT_LANGUAGE=English (India), conversational
DEFAULT_SCRIPT_LENGTH=700

# ---------------------------------------------------------------------------
# Media (optional overrides — bundled ffmpeg/ffprobe binaries are used by default)
# ---------------------------------------------------------------------------
# FFMPEG_PATH=
# FFPROBE_PATH=
RENDER_TIMEOUT_MS=1800000
