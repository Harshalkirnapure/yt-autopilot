{
  "name": "yt-autopilot-backend",
  "version": "1.0.0",
  "private": true,
  "description": "YT AutoPilot backend — AI topic/script/SEO, Edge TTS, Pexels clips, FFmpeg render, YouTube upload",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:db": "node scripts/run-db-tests.mjs",
    "smoke:youtube": "tsx src/smoke/youtubeSmoke.ts",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "worker": "tsx src/workers/renderWorker.ts",
    "migrate": "tsx src/db/migrate.ts",
    "run:daily": "tsx src/runDaily.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.3",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.7",
    "edge-tts-universal": "^1.4.0",
    "fastify": "^5.2.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^144.0.0",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
